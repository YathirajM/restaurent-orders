# --- Database ---
# Local SQLite (default). No external service required.
DATABASE_URL="file:./local.db"
# Production (Turso/LibSQL). Create at https://turso.io and set:
# TURSO_DATABASE_URL="libsql://your-db.turso.io?authToken=..."
# TURSO_AUTH_TOKEN="..."

# --- Application ---
APP_URL="http://localhost:3000"
NODE_ENV="development"
SESSION_SECRET="change-me-to-a-long-random-secret-in-production"

# --- Razorpay (required for live payments) ---
# Get keys at https://dashboard.razorpay.com
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_key_secret_here"

# --- Email (optional, for order confirmations) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@email.com"
# SMTP_PASS="your-app-password"
# ORDER_EMAIL_TO="restaurant@example.com"